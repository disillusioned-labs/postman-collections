{
	"info": {
		"_postman_id": "a1b2c3d4-0001-4a5a-9e01-identity000001",
		"name": "Identity",
		"description": "Identity service API.\n\n- Public endpoints (health, register, login, refresh, JWKS) skip auth.\n- Login/Refresh automatically save `access_token` and `refresh_token` into collection variables.\n- Protected requests use Bearer `{{access_token}}`.\n- Create Organization saves `organization_id` for the subfolders.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{ "key": "token", "value": "{{access_token}}", "type": "string" }
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		}
	],
	"variable": [
		{ "key": "identity_port", "value": ":8080" },
		{ "key": "access_token", "value": "" },
		{ "key": "refresh_token", "value": "" },
		{ "key": "organization_id", "value": "" },
		{ "key": "invitation_token", "value": "" }
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Liveness",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"url": {
							"raw": "{{base_url}}{{identity_port}}/healthz",
							"host": ["{{base_url}}{{identity_port}}"],
							"path": ["healthz"]
						}
					}
				},
				{
					"name": "Readiness",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"url": {
							"raw": "{{base_url}}{{identity_port}}/readyz",
							"host": ["{{base_url}}{{identity_port}}"],
							"path": ["readyz"]
						}
					}
				},
				{
					"name": "JWKS",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"url": {
							"raw": "{{base_url}}{{identity_port}}/.well-known/jwks.json",
							"host": ["{{base_url}}{{identity_port}}"],
							"path": [".well-known", "jwks.json"]
						}
					}
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 2xx\", () => pm.response.code < 300);",
									"const body = pm.response.json();",
									"if (body.data && body.data.access_token) {",
									"    pm.collectionVariables.set('access_token', body.data.access_token);",
									"    pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Imannuel\",\n    \"email\": \"imannuel@example.com\",\n    \"password\": \"secretpassword\"\n}"
						},
						"url": {
							"raw": "{{base_url}}{{identity_port}}/api/v1/auth/register",
							"host": ["{{base_url}}{{identity_port}}"],
							"path": ["api", "v1", "auth", "register"]
						}
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Login succeeded\", () => pm.response.code < 300);",
									"const body = pm.response.json();",
									"if (body.data && body.data.access_token) {",
									"    pm.collectionVariables.set('access_token', body.data.access_token);",
									"    pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"imannuel@example.com\",\n    \"password\": \"secretpassword\"\n}"
						},
						"url": {
							"raw": "{{base_url}}{{identity_port}}/api/v1/auth/login",
							"host": ["{{base_url}}{{identity_port}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					}
				},
				{
					"name": "Refresh",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Refresh succeeded\", () => pm.response.code < 300);",
									"const body = pm.response.json();",
									"if (body.data && body.data.access_token) {",
									"    pm.collectionVariables.set('access_token', body.data.access_token);",
									"    pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}{{identity_port}}/api/v1/auth/refresh",
							"host": ["{{base_url}}{{identity_port}}"],
							"path": ["api", "v1", "auth", "refresh"]
						}
					}
				},
				{
					"name": "Me",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}{{identity_port}}/api/v1/auth/me",
							"host": ["{{base_url}}{{identity_port}}"],
							"path": ["api", "v1", "auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "Organizations",
			"item": [
				{
					"name": "Organizations",
					"item": [
						{
							"name": "Create Organization",
							"event": [
								{
									"listen": "test",
									"script": {
										"type": "text/javascript",
										"exec": [
											"pm.test(\"Created\", () => pm.response.code < 300);",
											"const body = pm.response.json();",
											"if (body.data && body.data.id) {",
											"    pm.collectionVariables.set('organization_id', body.data.id);",
											"}"
										]
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{ "key": "Content-Type", "value": "application/json" }
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"name\": \"Disillusioned Labs\",\n    \"type\": \"company\"\n}"
								},
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", ""]
								}
							}
						},
						{
							"name": "List Organizations",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", ""]
								}
							}
						},
						{
							"name": "Get Organization",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}"]
								}
							}
						},
						{
							"name": "Update Organization",
							"request": {
								"method": "PATCH",
								"header": [
									{ "key": "Content-Type", "value": "application/json" }
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"name\": \"Disillusioned Labs (renamed)\"\n}"
								},
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}"]
								}
							}
						},
						{
							"name": "Delete Organization",
							"request": {
								"method": "DELETE",
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}"]
								}
							}
						}
					]
				},
				{
					"name": "Members",
					"item": [
						{
							"name": "List Members",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}/members",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}", "members"]
								}
							}
						},
						{
							"name": "Update Member Role",
							"request": {
								"method": "PATCH",
								"header": [
									{ "key": "Content-Type", "value": "application/json" }
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"role\": \"admin\"\n}"
								},
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}/members/{{user_id}}",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}", "members", "{{user_id}}"]
								}
							}
						},
						{
							"name": "Remove Member",
							"request": {
								"method": "DELETE",
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}/members/{{user_id}}",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}", "members", "{{user_id}}"]
								}
							}
						},
						{
							"name": "Leave Organization",
							"request": {
								"method": "DELETE",
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}/members/me",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}", "members", "me"]
								}
							}
						}
					]
				},
				{
					"name": "Invitations",
					"item": [
						{
							"name": "Create Invitation",
							"event": [
								{
									"listen": "test",
									"script": {
										"type": "text/javascript",
										"exec": [
											"pm.test(\"Created\", () => pm.response.code < 300);",
											"const body = pm.response.json();",
											"const token = body.data && (body.data.token || (body.data.invitation && body.data.invitation.token));",
											"if (token) {",
											"    pm.collectionVariables.set('invitation_token', token);",
											"}"
										]
									}
								}
							],
							"request": {
								"method": "POST",
								"header": [
									{ "key": "Content-Type", "value": "application/json" }
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"email\": \"newmember@example.com\",\n    \"role\": \"member\"\n}"
								},
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}/invitations",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}", "invitations"]
								}
							}
						},
						{
							"name": "List Invitations (organization)",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}/invitations",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}", "invitations"]
								}
							}
						},
						{
							"name": "List My Invitations",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/invitations",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "invitations"]
								}
							}
						},
						{
							"name": "Get Invitation by Token",
							"request": {
								"auth": { "type": "noauth" },
								"method": "GET",
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}/invitations/token/{{invitation_token}}",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}", "invitations", "token", "{{invitation_token}}"]
								}
							}
						},
						{
							"name": "Accept Invitation",
							"request": {
								"method": "POST",
								"header": [
									{ "key": "Content-Type", "value": "application/json" }
								],
								"body": {
									"mode": "raw",
									"raw": "{}"
								},
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}/invitations/{{invitation_id}}/accept",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}", "invitations", "{{invitation_id}}", "accept"]
								}
							}
						},
						{
							"name": "Accept Invitation by Token",
							"request": {
								"method": "POST",
								"header": [
									{ "key": "Content-Type", "value": "application/json" }
								],
								"body": {
									"mode": "raw",
									"raw": "{}"
								},
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}/invitations/token/{{invitation_token}}/accept",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}", "invitations", "token", "{{invitation_token}}", "accept"]
								}
							}
						},
						{
							"name": "Revoke Invitation",
							"request": {
								"method": "DELETE",
								"url": {
									"raw": "{{base_url}}{{identity_port}}/api/v1/organizations/{{organization_id}}/invitations/{{invitation_id}}",
									"host": ["{{base_url}}{{identity_port}}"],
									"path": ["api", "v1", "organizations", "{{organization_id}}", "invitations", "{{invitation_id}}"]
								}
							}
						}
					]
				}
			]
		}
	]
}
